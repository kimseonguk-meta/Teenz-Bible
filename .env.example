# Teenz Bible local operator configuration
#
# The deployed PWA, Firebase Functions, and iOS app do NOT currently read a .env
# file at runtime. This template is only for a developer's local Firebase CLI session.
#
# Copy this file to .env locally if you want a non-interactive Firebase deployment.
# Never commit .env or the referenced service-account JSON file.

# Optional: absolute path to a Firebase service-account JSON that has access to
# the teens-bible-94271 Firebase project. Leave blank when using `firebase login`.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/teens-bible-service-account.json

# Do not place any of the following in this file or in GitHub:
# - Apple certificates (.p12), App Store Connect API keys (.p8), provisioning profiles
# - OAuth client secrets or Firebase Admin private keys
# - User passwords, demo-account passwords, or personal access tokens
