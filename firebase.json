{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "site": "teens-bible-94271",
    "public": "dist/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/bible-ai", "function": "bibleAi", "region": "us-central1"},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}]},
      {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}]},
      {"source": "/manifest.json", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}]}
    ]
  }
}
