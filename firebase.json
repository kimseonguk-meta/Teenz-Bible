{
  "hosting": {
    "public": "firebase-deploy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/ipad",
        "destination": "/ipad/index.html"
      },
      {
        "source": "/ipad/**",
        "destination": "/ipad/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
