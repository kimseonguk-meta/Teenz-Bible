{
  "rules": {
    "userData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    },
    "groupMeta": {
      ".read": "auth != null",
      "$groupCode": {
        ".write": "auth != null"
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupCode": {
        "members": {
          "$uid": {
            ".read": true,
            ".write": "$uid === auth.uid"
          }
        },
        ".read": true
      }
    },
    "rankSnapshots": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "classConfig": {
      ".read": true,
      ".write": "auth != null"
    },
    "reports": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "date",
        "book",
        "status"
      ]
    },
    "flaggedChapters": {
      ".read": true,
      ".write": true
    },
    "notifications": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "date"
      ]
    },
    "adminTokens": {
      ".read": true,
      ".write": true
    },
    "memeReactions": {
      ".read": true,
      ".write": true
    },
    "memeSubmissions": {
      ".read": true,
      ".write": true
    },
    "feedbacks": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
