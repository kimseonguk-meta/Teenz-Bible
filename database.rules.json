{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupCode": {
        "members": {
          "$uid": {
            ".read": true,
            ".write": "$uid === auth.uid"
          }
        },
        ".read": true
      }
    },
    "rankSnapshots": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "classConfig": {
      ".read": true,
      ".write": "auth != null"
    },
    "reports": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["date", "book", "status"]
    }
  }
}
