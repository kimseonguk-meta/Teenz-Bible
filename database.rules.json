{
  "rules": {
    "challenges": {
      "$cid": {
        "aggregate": {
          "$date": {
            ".read": true,
            ".write": "auth != null",
            "doneCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "readingCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "config": {
          ".read": true,
          ".write": false
        },
        "manual": {
          "$uid": {
            "$date": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && ((auth.uid == $uid && newData.child('selfReported').val() == true && newData.child('byUid').val() == auth.uid && newData.child('done').isBoolean() && (!data.exists() || data.child('done').val() != true || (data.child('selfReported').val() == true && data.child('byUid').val() == auth.uid)) && root.child('challenges/' + $cid + '/participants/' + auth.uid).exists()) || root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val())"
            },
            ".read": "auth != null && auth.uid == $uid"
          },
          ".read": "auth != null && root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val()"
        },
        "participants": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || (root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val() && !newData.exists()))",
            ".validate": "!newData.exists() || (newData.child('role').val() == 'student' && newData.hasChildren(['role', 'name', 'joinedAt']) && (newData.hasChild('rosterNo') || newData.child('kind').val() == 'guest' || newData.child('kind').val() == 'leader'))"
          },
          ".read": "auth != null && root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val()"
        },
        "leaderClaims": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.child('proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val() && newData.hasChildren(['proof', 'name', 'joinedAt'])"
          }
        },
        "encouragements": {
          "$uid": {
            "$msgId": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val()"
            }
          },
          ".read": "auth != null && root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val()"
        },
        "progress": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || (root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val() && !newData.exists()))"
          },
          ".read": "auth != null && root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val()"
        },
        "rosterClaims": {
          "$date": {
            ".read": "auth != null",
            "$rosterNo": {
              ".write": "auth != null",
              ".validate": "((!newData.exists() && (data.child('uid').val() == auth.uid || root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val())) || (newData.exists() && newData.hasChildren(['uid', 'status']) && (newData.child('status').val() == 'reading' || newData.child('status').val() == 'done') && (newData.child('uid').val() == auth.uid || root.child('challenges/' + $cid + '/leaderClaims/' + auth.uid + '/proof').val() == root.child('challenges/' + $cid + '/config/codeHashLeader').val())))"
            }
          }
        }
      }
    },
    "classConfig": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "feedbacks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "groupMeta": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "groups": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "leaderboardGlobal": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "rankSnapshots": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reports": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "date",
        "book",
        "status"
      ]
    },
    "flaggedChapters": {
      ".read": true,
      ".write": true
    },
    "notifications": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "date"
      ]
    },
    "adminTokens": {
      ".read": true,
      ".write": true
    },
    "memeReactions": {
      ".read": true,
      ".write": true
    },
    "memeSubmissions": {
      ".read": true,
      ".write": true
    },
    "userData": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userGroups": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
