{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    },
    "groups": {
      "$groupCode": {
        "members": {
          "$uid": {
            ".read": true,
            ".write": "$uid === auth.uid"
          }
        },
        ".read": true
      }
    }
  }
}
